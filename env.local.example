# Public browser config
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Quid's current wallet and Gateway routes are intentionally testnet-only.
# Do not set this to mainnet until production wallets and Gateway support are migrated.
QUID_NETWORK=testnet
# Server-only RPC used for balance reads, activity indexing, and lifecycle
# reconciliation. Use a managed Arc Testnet endpoint in Vercel; do not expose
# its private key in a NEXT_PUBLIC variable.
ARC_RPC_URL=replace_with_managed_arc_testnet_rpc_url
# Optional server-only providers for reliable receive-wallet balance reads.
# Do not expose provider URLs containing keys through NEXT_PUBLIC_* variables.
AVALANCHE_FUJI_RPC_URL=
BASE_SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
OP_SEPOLIA_RPC_URL=
POLYGON_AMOY_RPC_URL=
UNICHAIN_SEPOLIA_RPC_URL=
# Browser-facing endpoint used by wallet fee estimates. Keep this endpoint
# public or provider-restricted; never place a private server key here.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_AVALANCHE_FUJI_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=
NEXT_PUBLIC_OP_SEPOLIA_RPC_URL=
NEXT_PUBLIC_POLYGON_AMOY_RPC_URL=
NEXT_PUBLIC_UNICHAIN_SEPOLIA_RPC_URL=
NEXT_PUBLIC_HYPEREVM_TESTNET_RPC_URL=
NEXT_PUBLIC_SEI_TESTNET_RPC_URL=
NEXT_PUBLIC_SONIC_TESTNET_RPC_URL=
NEXT_PUBLIC_WORLDCHAIN_SEPOLIA_RPC_URL=
# Create one at https://dashboard.reown.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_reown_walletconnect_project_id
NEXT_PUBLIC_SUPABASE_URL=replace_with_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_publishable_or_anon_key
# Set to true only after Google is enabled in Supabase Auth Providers.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
# Migration/admin only. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Secret used only by Vercel's scheduled payment-reconciliation request.
# Generate a long random value and configure the same value in Vercel.
CRON_SECRET=replace_with_a_long_random_secret

# Circle developer-controlled wallets.
# Never commit real values. Register the entity secret yourself in the Circle console.
CIRCLE_API_KEY=replace_with_circle_api_key
CIRCLE_ENTITY_SECRET=replace_with_32_byte_hex_entity_secret
CIRCLE_WALLET_SET_ID=replace_with_wallet_set_id

# Defaults are Arc Testnet EOA wallets. Override only when Circle's dashboard/API
# uses a different blockchain identifier for your account.
CIRCLE_WALLET_BLOCKCHAIN=ARC-TESTNET
CIRCLE_WALLET_ACCOUNT_TYPE=EOA
